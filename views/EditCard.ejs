      <div class="lp-1bg-2 row"></div>
      <div class="scroll up upAni"></div>
      <div
        class="fade modal"
        id="edit_modal"
        tabindex="-1"
        aria-labelledby="edit_label"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <p class="root-p modal-title">Edit Card</p>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="close"
                data-dismiss="modal"
                aria-label="Close"
              >
                <path
                  d="M24 20.188l-8.315-8.209 8.2-8.282-3.697-3.697-8.212 8.318-8.31-8.203-3.666 3.666 8.321 8.24-8.206 8.313 3.666 3.666 8.237-8.318 8.285 8.203z"
                />
              </svg>
            </div>
            <div class="modal-body" style="padding: 2rem !important">
              <input
                type="text"
                name="code"
                class="card-code"
                style="display: none"
              />
              <div class="group">
                <input
                  type="text"
                  name="name"
                  required="required"
                  autocomplete="off"
                  class="card-name"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Card Name</label>
              </div>
              <div class="group">
                <input
                  type="text"
                  name="act"
                  required="required"
                  autocomplete="off"
                  class="card-act"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Card Act</label>
              </div>
              <div class="group">
                <input
                  type="text"
                  name="subAct"
                  required="required"
                  autocomplete="off"
                  class="card-sub-act"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Card Sub-Act</label>
              </div>
              <div class="group">
                <select
                  name="rarity"
                  class="rarity"
                  style="padding: 10px 10px 10px 0px !important"
                >
                  <option value="1">⭐</option>
                  <option value="2">⭐⭐</option>
                  <option value="3">⭐⭐⭐</option>
                  <option value="4">⭐⭐⭐⭐</option>
                  <option value="5">⭐⭐⭐⭐⭐</option>
                </select>
                <label>Card Rarity</label>
              </div>
              <div class="group">
                <select
                  aria-selected="true"
                  name="old"
                  class="card-old"
                  style="padding: 10px 10px 10px 0px !important"
                >
                  <option value="false">Yes</option>
                  <option value="true">No</option>
                </select>
                <label>Card Drop</label>
              </div>
              <div class="group file-area">
                <input type="file" name="image" class="card-image" />
                <div class="file-dummy">
                  <div class="success">Thanks for creating cards.</div>
                  <div class="default">Please select some card.</div>
                </div>
                <img
                  class="lp-321im"
                  style="display: block !important"
                  src="/Images/Nezoku.png"
                />
              </div>
              <div class="modal-footer">
                <button
                  type="button"
                  class="lp-23sp-2 lp-btn7 lp-btn7-g"
                  data-dismiss="modal"
                >
                  Save
                </button>
                <button
                  type="button"
                  class="lp-btn7 lp-btn7-r"
                  data-dismiss="modal"
                >
                  Cancel
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="fade modal"
        id="delete_modal"
        tabindex="-1"
        aria-labelledby="delete_label"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <p class="root-p modal-title">Delete Card</p>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="close"
                data-dismiss="modal"
                aria-label="Close"
              >
                <path
                  d="M24 20.188l-8.315-8.209 8.2-8.282-3.697-3.697-8.212 8.318-8.31-8.203-3.666 3.666 8.321 8.24-8.206 8.313 3.666 3.666 8.237-8.318 8.285 8.203z"
                />
              </svg>
            </div>
            <div class="modal-body">
              <p class="root-p lp-3te23"></p>
              <input
                type="text"
                name="code"
                class="card-code"
                style="display: none"
              />
              <div class="group">
                <input
                  type="password"
                  name="name"
                  required="required"
                  autocomplete="off"
                  id="password"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Enter the Password</label>
              </div>
              <div class="modal-footer">
                <button
                  type="button"
                  class="lp-btn7 lp-btn7-r"
                  data-dismiss="modal"
                >
                  Cancel
                </button>
                <button
                  class="lp-32des-2 lp-btn7 lp-btn7-g"
                  data-dismiss="modal"
                >
                  Save
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="fade modal"
        id="searchQuery_modal"
        tabindex="-1"
        aria-labelledby="searchQuery_label"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <p class="root-p modal-title">Search Name</p>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="close"
                data-dismiss="modal"
                aria-label="Close"
              >
                <path
                  d="M24 20.188l-8.315-8.209 8.2-8.282-3.697-3.697-8.212 8.318-8.31-8.203-3.666 3.666 8.321 8.24-8.206 8.313 3.666 3.666 8.237-8.318 8.285 8.203z"
                />
              </svg>
            </div>
            <div class="modal-body" style="margin-top: 1.7rem !important">
              <div class="group">
                <input
                  type="text"
                  name="name"
                  required="required"
                  autocomplete="off"
                  class="card-name-sub"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Name Query</label>
              </div>
              <div class="group">
                <input
                  type="text"
                  name="act"
                  required="required"
                  autocomplete="off"
                  class="card-act-sub"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Act Query</label>
              </div>
              <div class="group">
                <input
                  type="text"
                  name="set-act"
                  required="required"
                  autocomplete="off"
                  class="card-sub-act-sub"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Sut-Act Query</label>
              </div>
              <div class="group">
                <input
                  type="text"
                  name="card-code"
                  required="required"
                  autocomplete="off"
                  class="card-code-sub"
                />
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>Code Query</label>
              </div>
              <div class="group">
                <select
                  name="rarity"
                  style="
                    padding: 0.625rem 0.625rem 0.625rem 0px !important;
                    cursor: pointer;
                  "
                  class="rarity-sub"
                  required
                >
                  <option>Rarity</option>
                  <option value="1">⭐</option>
                  <option value="2">⭐⭐</option>
                  <option value="3">⭐⭐⭐</option>
                  <option value="4">⭐⭐⭐⭐</option>
                  <option value="5">⭐⭐⭐⭐⭐</option>
                </select>
                <label>Rarity Query</label>
              </div>
            </div>
            <div class="modal-footer">
              <button class="lp-btn7 lp-btn7-g lp-4btn3-s" data-dismiss="modal">
                Save
              </button>
              <button class="lp-btn7 lp-btn7-r lp-5btn4-c" data-dismiss="modal">
                Clear
              </button>
            </div>
          </div>
        </div>
      </div>
      <div id="checker" style="visibility: hidden; height: 40px"></div>
    </section>
