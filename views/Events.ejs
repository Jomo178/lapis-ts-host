    <div
      class="fade modal"
      id="events_modal"
      tabindex="-1"
      aria-labelledby="events_label"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <p class="root-p modal-title">New Event?</p>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <path
                d="M24 20.188l-8.315-8.209 8.2-8.282-3.697-3.697-8.212 8.318-8.31-8.203-3.666 3.666 8.321 8.24-8.206 8.313 3.666 3.666 8.237-8.318 8.285 8.203z"
              />
            </svg>
          </div>
          <div class="modal-body" style="padding: 2rem !important">
            <div class="group">
              <input
                type="text"
                name="name"
                required="required"
                autocomplete="off"
                class="event-name"
              />
              <span class="highlight"></span>
              <span class="bar"></span>
              <label>Event Name</label>
            </div>
            <div class="group">
              <input
                type="datetime-local"
                name="start"
                required="required"
                autocomplete="off"
                class="event-start"
              />
              <span class="highlight"></span>
              <span class="bar"></span>
              <label>Event Start</label>
            </div>
            <div class="group">
              <input
                type="datetime-local"
                name="end"
                required="required"
                autocomplete="off"
                class="event-end"
              />
              <span class="highlight"></span>
              <span class="bar"></span>
              <label>Event End</label>
            </div>
            <div class="group">
              <input
                type="text"
                name="emoji"
                required="required"
                autocomplete="off"
                class="event-emoji"
              />
              <span class="highlight"></span>
              <span class="bar"></span>
              <label>Event Emoji</label>
            </div>
            <div class="group">
              <input
                type="number"
                min="1"
                max="100"
                value="75"
                name="required"
                autocomplete="off"
                class="event-required"
              />
              <span class="highlight"></span>
              <span class="bar"></span>
              <label>Event Required</label>
            </div>
            <div class="modal-footer">
              <button
                type="submit"
                class="lp-23sp-2 lp-btn7 lp-btn7-g"
                data-dismiss="modal"
              >
                Save
              </button>
              <button
                type="button"
                class="lp-btn7 lp-btn7-r"
                data-dismiss="modal"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
