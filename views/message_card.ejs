<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("./custom/yxhsehdwusx.ejs") %>
    <style>
      .save {
        padding: 0.5rem 1.875rem;
        background-color: var(--cyan);
        text-transform: uppercase;
        font-weight: 600;
        font-size: 0.875rem;
        border-radius: 0.125rem;
        cursor: pointer;
        transition: cubic-bezier(1, 0.99, 0, 0.01) 1s;
      }

      .save:hover {
        background-color: rgb(0, 255, 255);
      }

      .save:nth-child(2) {
        background-color: green;
      }

      .text {
        text-align: center;
        margin-bottom: 2rem;
      }
    </style>
  </head>
  <body class="lp-1bg-0">
    <%- include("./custom/zjkcqxqfym.ejs") %>
    <div class="lp-2cp2p">
      <p class="root-p text"><%= message %></p>
      <button class="save" onclick="location.href = '/addcard'">
        add card?
      </button>
      <button class="save" onclick="location.href ='/editcard'">
        edit card?
      </button>
    </div>
  </body>
</html>
